# Copy to <name>.env (e.g. dev1.env). <name> is the TEST_ENV value.
# Connection settings only. Never put passwords, client secrets or tokens here.
# ENV_TYPE: dev | test | uat | prod (prod is always refused by playwright.config.ts)
ENV_TYPE=dev
D365_URL=https://<environment>.cloud.onebox.dynamics.com
D365_COMPANY=USMF